# /etc/meroauction/web.env   (owner root:meroauction, mode 640)
# Used by `npm run build` (deploy.sh) and by the website service.
NODE_ENV='production'
NEXT_TELEMETRY_DISABLED='1'
# nginx sends /api/v1 straight to the API. This value is the fallback inside the Next.js build
# and is baked in at BUILD time, so changing it needs a new build.
API_PROXY_TARGET='http://127.0.0.1:4000'
# Keeps memory use of image processing (sharp) low on glibc Linux.
MALLOC_ARENA_MAX='2'
