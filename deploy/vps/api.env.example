# /etc/meroauction/api.env   (owner root:meroauction, mode 640). NEVER commit the real file.
# setup-server.sh copies this file and fills every __PLACEHOLDER__ with a generated value.
# Keep values in single quotes. One variable per line, no spaces around "=".

NODE_ENV='production'
API_PORT='4000'
TRUST_PROXY='1'

# Public addresses (website, API and images are all on the same domain)
FRONTEND_URL='https://meroauction.com'
API_PUBLIC_URL='https://meroauction.com'
CORS_ORIGIN='https://meroauction.com'
APP_ORIGIN='https://meroauction.com'
WEBAUTHN_ORIGIN='https://meroauction.com'
WEBAUTHN_RP_ID='meroauction.com'

# Database (PostgreSQL on this same server, reachable only from localhost)
DATABASE_URL='postgresql://meroauction:__DB_PASSWORD__@127.0.0.1:5432/meroauction'

# Secrets. If you are MOVING from Render, copy the old JWT_SECRET (and KYC_URL_SECRET if you had one) here.
# Changing JWT_SECRET signs everyone out and makes stored KYC document numbers unreadable.
JWT_SECRET='__JWT_SECRET__'
# KYC_URL_SECRET=''
NEXLO_ADMIN_SECRET='__ADMIN_SECRET__'
# ADMIN_EMAIL=''

# Uploaded images live on this server's disk (nginx serves /uploads/).
# Leave AWS_* and CDN_* unset so image links stay "/uploads/...".
STORAGE_DRIVER='fs'
UPLOAD_DIR='/var/lib/meroauction/uploads'

# E-mail (Resend). EMAIL_FROM must use the domain verified in Resend.
RESEND_API_KEY=''
EMAIL_FROM='MeroAuction <no-reply@meroauction.com>'

# Google sign-in (Client ID only; the secret is not used)
GOOGLE_CLIENT_ID=''
ALLOW_DEMO_SOCIAL='0'

# Payments. Sandbox values until the real merchant accounts are ready.
# When you take real money: put the real keys below, switch the URLs to the live services and set PAYMENTS_LIVE='1'.
# With PAYMENTS_LIVE='1' the API refuses to start while any sandbox value is still in use.
PAYMENTS_LIVE='0'
# ESEWA_MERCHANT_CODE=''
# ESEWA_SECRET_KEY=''
# ESEWA_URL=''
# ESEWA_VERIFY_URL=''
# KHALTI_SECRET_KEY=''
# KHALTI_API_URL=''
# KHALTI_VERIFY_URL=''

# Optional
# SPARROW_TOKEN=''
# REMOVE_BACKGROUND='false'
