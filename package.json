{
  "name": "nexlo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "node server/index.mjs",
    "dev:worker": "node server/worker.mjs",
    "dev:all": "concurrently -n web,api,worker -c blue,green,magenta \"npm run dev\" \"npm run dev:api\" \"npm run dev:worker\"",
    "db:migrate": "node --import dotenv/config scripts/migrate.mjs",
    "db:seed-taxonomy": "node scripts/seed-taxonomy.mjs",
    "db:up": "docker compose -f infra/docker-compose.yml up -d postgres redis",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test server/*.test.mjs",
    "test:load": "node scripts/load-test.mjs",
    "test:smoke": "node scripts/functional-smoke.mjs",
    "test:uat": "node scripts/uat.mjs",
    "test:authz": "node scripts/authz-test.mjs",
    "test:catalog": "node scripts/catalog-admin-test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-presigned-post": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "@electric-sql/pglite": "^0.5.16",
    "@imgly/background-removal-node": "^1.4.5",
    "@neon/config": "^1.14.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.4.7",
    "files-sdk": "^2.6.2",
    "form-data": "^4.0.6",
    "hash-wasm": "^4.13.0",
    "mailgun.js": "^14.1.1",
    "multer": "^2.4.0",
    "next": "^16.4.6",
    "pg": "^8.13.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "^16.4.6"
  },
  "overrides": {
    "lodash": "^4.17.24",
    "sharp": "$sharp",
    "hono": "^4.13.18",
    "@hono/node-server": "^2.1.8",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    }
  }
}
